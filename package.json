{
  "private": true,
  "version": "0.1.18",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "prepare": "node -e \"try { require('child_process').execSync('husky', { stdio: 'inherit' }) } catch (e) {}\""
  },
  "devDependencies": {
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0"
  },
  "lint-staged": {
    "client/src/**/*.{ts,tsx}": [
      "prettier --write"
    ],
    "server/src/**/*.{js}": [
      "prettier --write"
    ]
  }
}
